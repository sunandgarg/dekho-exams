{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dekhoexams-frontend",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "vars": {
    "SCHOOL_WORDPRESS_URL": ""
  },
  "assets": {
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/__data/*", "/downloads/*", "/java-coverage.html", "/learning-coverage.html"],
  },
  "observability": { "enabled": true },
}
