# Set after the Dekhoexams School Content plugin is active on Hostinger.
SCHOOL_WORDPRESS_URL=

# Legacy computing CMS; leave unset unless its separate API is deployed.
WORDPRESS_URL=
VITE_WORDPRESS_URL=

# Keep the temporary deployment labelled as sample content.
VITE_PREVIEW_MODE=true

# Canonical frontend HTTPS origin; change only after the new domain is connected.
VITE_SITE_URL=https://dekhoexams.com
# VITE_PREVIEW_MODE defaults to true even when unset. Preview is globally noindex
# and its sitemap intentionally contains zero URLs. Set false only for launch.
# Reviewed published content also needs data.seo_ready=true to be indexable.
