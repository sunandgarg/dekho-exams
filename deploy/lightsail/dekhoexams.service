[Unit]
Description=DekhoExams Node origin
After=network-online.target
Wants=network-online.target

[Service]
User=dekhoexams
WorkingDirectory=/srv/dekhoexams
EnvironmentFile=/etc/dekhoexams/app.env
Environment=NODE_ENV=production HOST=127.0.0.1 PORT=3000 TRUST_PROXY=true
ExecStart=/usr/local/bin/node server/start.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
