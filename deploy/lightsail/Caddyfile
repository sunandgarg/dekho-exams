{$ORIGIN_HOST} {
    encode zstd gzip
    @edge header X-Origin-Key {$ORIGIN_KEY}
    handle @edge {
        reverse_proxy 127.0.0.1:3000 {
            header_up X-Forwarded-Host {http.request.header.X-Dekho-Host}
            header_up X-Forwarded-Proto https
            header_up -X-Origin-Key
            header_up -X-Dekho-Host
        }
    }
    respond 403
}
